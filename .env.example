# OpenAI-compatible base URL of your multimodal LLM.
# Examples:
#   OpenAI:        https://api.openai.com/v1
#   Qwen (DashScope compatible mode): https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek:      https://api.deepseek.com/v1
#   Ollama (local): http://localhost:11434/v1
#   vLLM / LM Studio: http://localhost:1234/v1
LLM_API_URL=https://api.openai.com/v1

# Model name with vision support, e.g. gpt-4o, gpt-4o-mini,
# qwen-vl-max, qwen2.5-vl-72b-instruct, llama3.2-vision, etc.
LLM_MODEL_NAME=gpt-4o

# API key (Bearer token). For local servers without auth (Ollama),
# use any non-empty placeholder such as "ollama".
LLM_API_KEY=sk-your-key-here

# --- Optional ---
# Fetch remote image URLs server-side and send as base64 (default: true).
# Required for providers that can't fetch URLs themselves (Aliyun Token Plan).
LLM_FETCH_REMOTE=true
# Max image size in bytes, default 25MB.
LLM_IMAGE_MAX_BYTES=26214400
